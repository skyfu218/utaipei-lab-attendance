rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function p() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && p().data.active == true && p().data.role in ['staff','admin']; }
    function admin() { return signedIn() && p().data.active == true && p().data.role == 'admin'; }
    match /users/{uid} {
      allow create: if self(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.role == 'pending' && request.resource.data.active == false;
      allow read: if self(uid) || admin();
      allow update: if admin() || (self(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email && request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active);
      allow delete: if false;
    }
    match /tags/{id} { allow read: if active(); allow write: if admin(); }
    match /attendance/{id} {
      allow read: if admin() || (active() && resource.data.userId == request.auth.uid);
      allow create: if active() && request.resource.data.userId == request.auth.uid && request.resource.data.checkInAt == request.time && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if active() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.date == resource.data.date && request.resource.data.checkInAt == resource.data.checkInAt && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.checkOutAt == request.time && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /requests/{id} {
      allow read: if admin() || (active() && resource.data.userId == request.auth.uid);
      allow create: if active() && request.resource.data.userId == request.auth.uid && request.resource.data.status == '待審核' && request.resource.data.createdAt == request.time;
      allow update: if admin(); allow delete: if false;
    }
    match /messages/{id} {
      allow read: if admin() || (active() && resource.data.toUid == request.auth.uid);
      allow create: if admin() && request.resource.data.fromUid == request.auth.uid;
      allow update: if active() && resource.data.toUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']) && request.resource.data.read == true && request.resource.data.readAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
